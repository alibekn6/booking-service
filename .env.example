# Local development against `docker compose up -d postgres redis`.
# Inside compose the services get their own values from docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5433/booking
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
LOG_JSON=false
LOG_LEVEL=INFO

# Business rules
HOLD_TTL_S=600
MAX_SEATS_PER_BUYER=4

# Host ports used by docker compose (5432/8000 are often taken locally)
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8080
